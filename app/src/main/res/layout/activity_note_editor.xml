<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <EditText
        android:id="@+id/editTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@null"
        android:hint="Заголовок"
        android:textColorHint="#999999"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/noteContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toTopOf="@+id/drawingToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTitle">

        <com.mixnote.views.ZoomableImageView
            android:id="@+id/imageAttachment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <EditText
            android:id="@+id/editContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="top|start"
            android:hint="Текст заметки..."
            android:textColorHint="#999999"
            android:textColor="#000000"
            android:textSize="16sp" />

        <com.mixnote.views.MixNoteCanvas
            android:id="@+id/drawingCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Панель рисования -->
    <LinearLayout
        android:id="@+id/drawingToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFEFEF"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomToolbar">

        <Button
            android:id="@+id/btnBrushColor"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="2px"
            android:text="Цвет кисти"
            android:textSize="12sp"
            android:background="@drawable/rounded_button" />

        <Button
            android:id="@+id/btnBrushSize"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="2px"
            android:text="Толщина"
            android:textSize="12sp"
            android:background="@drawable/rounded_button" />
    </LinearLayout>

            <!-- Главная нижняя панель с ИКОНКАМИ -->
    <HorizontalScrollView
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnToggleDraw"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🖌️"
                android:textSize="20sp"
                android:background="@drawable/rounded_button" />
                
            <Button
                android:id="@+id/btnToggleEraser"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🧽"
                android:textSize="20sp"
                android:visibility="gone"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnTextColor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🎨"
                android:textSize="20sp"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnTextSize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🔠"
                android:textSize="20sp"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnAddImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🖼️"
                android:textSize="20sp"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="📤"
                android:textSize="20sp"
                android:background="@drawable/rounded_button" />

            <!-- Кнопка "Сохранить" останется с текстом и иконкой для понятности -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="💾 Сохранить"
                android:textColor="#FFFFFF"
                android:background="@drawable/rounded_button" />
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
